# Copie para e2e/.env e ajuste. Valores para o ambiente LOCAL de desenvolvimento — os
# roteiros criam usuários e dados de teste, então nunca aponte para produção.

E2E_API_URL=http://127.0.0.1:8080/api
E2E_FRONT_URL=http://localhost:3000
E2E_KEYCLOAK_URL=http://localhost:8083
E2E_REALM=barueri

# Administrador do Keycloak local (o mesmo do docker-compose de desenvolvimento).
E2E_KEYCLOAK_ADMIN_USER=arquitetura
E2E_KEYCLOAK_ADMIN_PASSWORD=admin

# Senha que o roteiro dá aos usuários de teste que ele mesmo cria
# (teste.admin, 90000000002 e 90000000003). Escolha qualquer uma.
E2E_TEST_USER_PASSWORD=troque-esta-senha-de-teste

# Onde está o Postgres (o roteiro confere e limpa dados de teste direto no banco).
E2E_POSTGRES_CONTAINER=postgres
E2E_POSTGRES_USER=arquitetura
E2E_POSTGRES_DB=psychology
