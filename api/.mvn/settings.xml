<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração do Maven só deste projeto: baixa tudo do Maven Central e ignora o
  settings.xml da máquina (que pode apontar para um Nexus corporativo inacessível).
  É aplicada automaticamente pelo .mvn/maven.config. Não coloque credenciais aqui.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <activeProfiles>
    <activeProfile>maven-central</activeProfile>
  </activeProfiles>
  <profiles>
    <profile>
      <id>maven-central</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
